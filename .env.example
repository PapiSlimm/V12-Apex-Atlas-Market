# ---------------------------------------------------------------------------
# V12 Apex Atlas — environment template. Copy to .env and fill in.
# Never commit a real .env. Never paste a real secret into this file.
# ---------------------------------------------------------------------------

# REQUIRED IN PRODUCTION. At least 32 random characters; the server refuses to
# start in production without it. Generate one with:
#   openssl rand -hex 32
# In development an ephemeral secret is generated per process, so sessions
# reset whenever you restart.
JWT_SECRET=

# Optional. Without it, every model-backed feature degrades to a clearly
# labelled local fallback. Routing, the Hermes engine, the vault and telemetry
# are deterministic and work with no key at all.
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.5-flash.
GEMINI_MODEL=

# Optional. Defaults to 3000.
PORT=

# Optional. Postgres connection string. When unset the app uses SQLite at
# $DATA_DIR/apex-atlas.db — zero configuration, durable, fine for one node.
# Set this to scale out; the schema is created automatically on first boot.
DATABASE_URL=

# Optional. Force TLS for Postgres. Also inferred from sslmode=require in the URL.
PGSSL=

# Optional. Where the SQLite database is written. Defaults to ./data
DATA_DIR=

# Optional. Override the SQLite file path directly.
SQLITE_PATH=

# Optional, tests only. When set, the store conformance suite runs against
# Postgres in addition to SQLite. Use a throwaway database — the suite wipes it.
TEST_DATABASE_URL=

# ---------------------------------------------------------------------------
# Deployment shape
# ---------------------------------------------------------------------------

# REQUIRED by `docker compose up`. Password for the bundled Postgres service.
# Compose aborts without it, which is why it is listed here and not only in
# DEPLOYMENT.md.
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Optional. `true` enables per-organisation signup — the cloud edition. Leave
# unset for self-hosted and desktop: everyone joins one organisation.
MULTI_TENANT=

# Optional. Display name and plan for the single-tenant organisation.
DEFAULT_TENANT_NAME=
DEFAULT_TENANT_PLAN=

# ---------------------------------------------------------------------------
# Closed beta
# ---------------------------------------------------------------------------

# "true" requires a valid invite code to register. Mint codes with:
#   npm run invite -- mint --label "someone@example.com"
# There is deliberately NO HTTP endpoint that mints codes — an invite-printing
# API is the highest-value target on a free beta. Shell access is the gate.
INVITE_ONLY=

# Hard ceiling on the number of organisations. Independent of invites on
# purpose: over-issuing codes must not be able to exceed the number of accounts
# you decided to support. 0 or unset disables the cap.
BETA_MAX_TENANTS=

# ---------------------------------------------------------------------------
# Administrative API
# ---------------------------------------------------------------------------
# Enables POST/GET /api/admin/invites and /api/admin/usage.
#
# UNSET MEANS THE ROUTES ARE NOT MOUNTED AT ALL — not mounted and disabled.
# This endpoint prints invite codes, so leave it unset unless you need it and
# use `npm run invite` from a shell instead.
#
# At least 32 characters or the server refuses to boot: a short admin token is
# worse than none because it produces the confidence of having one.
#   openssl rand -hex 32
ADMIN_API_TOKEN=

# Optional. Comma-separated exact IPs allowed to call the admin API. Anything
# else gets the same 404 as a wrong token.
ADMIN_IP_ALLOWLIST=

# ---------------------------------------------------------------------------
# Inference metering
# ---------------------------------------------------------------------------
# Token prices, in CENTS per million tokens, from your provider's price list.
#
# Leave these unset and deliberately HIGH placeholders apply: spend is
# over-counted and users are cut off early. That is the safe direction to be
# wrong in — the opposite default under-counts and hands out an unbounded bill.
# `npm run preflight` BLOCKS if an API key is configured and these are not.
AI_INPUT_CENTS_PER_MTOK=
AI_OUTPUT_CENTS_PER_MTOK=

# ---------------------------------------------------------------------------
# Risk limits
# ---------------------------------------------------------------------------
# All optional; the defaults are the values in parentheses. These are ceilings
# on ledger instructions, enforced server-side before anything is persisted.

RISK_MAX_ORDER_NOTIONAL=      # single instruction (250,000)
RISK_MAX_DAILY_NOTIONAL=      # rolling 24h (1,000,000)
RISK_MAX_POSITION_NOTIONAL=   # per-position concentration (500,000)
RISK_MAX_QUOTE_AGE_MS=        # refuse bids older than this (5,000)
RISK_START_HALTED=            # "true" boots with the kill switch engaged

# ---------------------------------------------------------------------------
# Asset marketplace
# ---------------------------------------------------------------------------

# The internal marketplace models bids for the media blocks your production
# nodes hold. There is no external exchange adapter and none is planned — see
# the scope note at the top of server/assets/index.ts.
#
# "realistic" (default) injects partial fills, rejections and dropped
# connections so the recovery paths stay exercised; "calm" fills cleanly and is
# what you want for a demo.
MARKET_BEHAVIOUR=

# Optional. Seeds two demo accounts at first boot. Leave unset in production —
# seeded credentials in a live deployment are how demo logins become breaches.
ENABLE_DEMO_USERS=
DEMO_PASSWORD=

# ---------------------------------------------------------------------------
# Ecosystem — outbound (this app calling its peers, through Orion)
# ---------------------------------------------------------------------------
# Apex Atlas is a member of the v12 ecosystem on equal terms with Nexion,
# V12 OS, Orion Prime and CEOS. It initiates as well as receives.
#
# Unset means outbound is DISABLED rather than half-configured — both of these
# are required together or neither does anything.

# The broker's base URL. https only, except localhost in development.
ORION_URL=

# THIS app's Ed25519 private key, base64 PKCS8. Generated on this machine with
# `npm run keys -- member v12-apex-atlas` in the orion repo. It signs requests,
# it is never transmitted, and Orion holds only the public half. If this ever
# appears in the broker's registry, the whole design has collapsed.
ORION_PRIVATE_KEY=

# Optional. Outbound request timeout in ms (default 8000).
ORION_TIMEOUT_MS=

# ---------------------------------------------------------------------------
# Orion Prime — a peer application, read for liveness only
# ---------------------------------------------------------------------------
# Independent of the broker path above. No credentials are sent; this is an
# unauthenticated read of a public health endpoint and nothing more.
ORION_PRIME_URL=
ORION_PRIME_TIMEOUT_MS=
